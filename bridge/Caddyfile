{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	@mcp path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /authorize /token /register /revoke
	@site path / /privacidade /conectado
	handle @site {
		root * /srv/site
		rewrite /privacidade /privacidade.html
		rewrite /conectado /conectado.html
		file_server
	}
	handle @mcp {
		reverse_proxy mcp:8081
	}
	handle {
		reverse_proxy bridge:8080
	}
}
