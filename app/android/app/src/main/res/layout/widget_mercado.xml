<?xml version="1.0" encoding="utf-8"?>
<!--
  Lista de mercado: título (toque abre Compras) e até 12 linhas, que são cabeçalhos de seção ou itens
  pendentes (toque no item marca como comprado). O provider esconde as linhas que não cabem na altura.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
